{"source_id": 15263, "link": "", "label": " ඕඝ වර්ගය", "book": null, "url": "https://tripitaka.online/sutta/15263", "prev": null, "next": null, "blocks": [{"seq": 0, "tag": "h1", "class": "sutta-title", "lang": null, "content": "සංයුත්ත නිකාය"}, {"seq": 1, "tag": "h1", "class": "sutta-title", "lang": null, "content": "මහා වග්ගෝ"}, {"seq": 2, "tag": "h2", "class": "sutta-title", "lang": null, "content": "13. ඕඝවග්ගෝ"}, {"seq": 3, "tag": "h3", "class": "sutta-title", "lang": null, "content": "13. ඕඝ වර්ගය"}, {"seq": 4, "tag": "h2", "class": "sutta-title", "lang": null, "content": "2.13.1.-40 ඕඝාදී සූත්‍රයෝ"}, {"seq": 5, "tag": "h3", "class": "sutta-title", "lang": null, "content": "සැඩපහර ගැන වදාළ දෙසුම ආදී දෙසුම්"}, {"seq": 6, "tag": "p", "class": "pali-text", "lang": "pali", "content": "චත්තාරෝමේ භික්ඛවේ, ඕඝා. කතමේ චත්තාරෝ: කාමෝඝෝ, භවෝඝෝ, දිට්ඨෝඝෝ, අවිජ්ජෝඝෝ ....(පෙ).... භාවේතබ්බෝති."}, {"seq": 7, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "මහණෙනි, මේ සැඩපහර සතරකි. ඒ කවර සතරක් ද යත්, කාම ඕඝය, භව ඕඝය, දිට්ඨි ඕඝය, අවිද්‍යා ඕඝය ය. ….(පෙ)…. වැඩිය යුත්තේ ය."}, {"seq": 8, "tag": "p", "class": "pali-text", "lang": "pali", "content": "(මග්ගසංයුත්තස්ස ඕඝවග්ගෝ විය විත්ථාරේතබ්බෝ)"}, {"seq": 9, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මග්ග සංයුත්තයේ ඕඝ වර්ගය මෙන් විස්තර කළ යුත්තේය.)"}, {"seq": 10, "tag": "p", "class": "sutta-title", "lang": null, "content": "ඕඝවග්ගෝ තේළසමෝ."}, {"seq": 11, "tag": "p", "class": "sutta-title", "lang": null, "content": "දහතුන් වෙනි ඕඝ වර්ගය අවසන් විය."}, {"seq": 12, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තත්‍රැද්දානං:"}, {"seq": 13, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "එහි පිළිවෙල උද්දානයයි :"}, {"seq": 14, "tag": "p", "class": "gatha pali-text", "lang": "pali", "content": "ඕඝෝ යෝගෝ උපාදානං ගන්ථෝ අනුසයේන ච\nකාමගුණා නීවරණා ඛන්ධා ඕරුද්ධම්භාගියාති"}, {"seq": 15, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "ඕඝ, යෝග, උපාදාන, ගන්ථ, අනුසය, කාමගුණ, නීවරණ, ඛන්ධ, ඕරම්භාගිය, උද්ධම්භාගිය වශයෙන් සතර බැගින් දසයකි. මෙහි මුළු සූත්‍ර ගණන සතළිසකි."}], "bjt": {"pali": [{"seq": 0, "tag": "centered", "content": "(පඨමො ගන්ථො)"}, {"seq": 1, "tag": "heading", "content": "ඛුද්දකපාඨපාළි"}, {"seq": 2, "tag": "centered", "content": "නමො තස්ස භගවතො අරහතො සම්මාසම්බුද්ධස්ස."}, {"seq": 3, "tag": "heading", "content": "1. සරණගමනං"}, {"seq": 4, "tag": "paragraph", "content": "බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 5, "tag": "paragraph", "content": "ධම්මං සරණං ගච්ඡාමි."}, {"seq": 6, "tag": "paragraph", "content": "සඞ්ඝං සරණං ගච්ඡාමි."}, {"seq": 7, "tag": "paragraph", "content": "දුතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 8, "tag": "paragraph", "content": "දුතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 9, "tag": "paragraph", "content": "දුතියම්පි සඞ්ඝං සරණං ගච්ඡාමි."}], "sinhala": [{"seq": 0, "tag": "centered", "content": "(ප්රථම ග්රන්ථය)"}, {"seq": 1, "tag": "heading", "content": "ඛුද්දකපාඨ පෙළ"}, {"seq": 2, "tag": "centered", "content": "ඒ භාග්යවත් අර්හත් සම්මාසම්බුදුරජාණන් වහන්සේට නමස්කාර වේවා."}, {"seq": 3, "tag": "heading", "content": "1. ශරණගමනය"}, {"seq": 4, "tag": "paragraph", "content": "බුදුරජුන් සරණයෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 5, "tag": "paragraph", "content": "දහම් සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 6, "tag": "paragraph", "content": "සඟ සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 7, "tag": "paragraph", "content": "දෙවනු ද බුදුරජුන් සරණ යෙමි."}, {"seq": 8, "tag": "paragraph", "content": "දෙවනු ද දහම් සරණ යෙමි."}, {"seq": 9, "tag": "paragraph", "content": "දෙවනු ද සඟ සරණ යෙමි."}]}}