{"source_id": 15269, "link": "", "label": " පුන ඕඝ වර්ගය", "book": null, "url": "https://tripitaka.online/sutta/15269", "prev": null, "next": null, "blocks": [{"seq": 0, "tag": "h1", "class": "sutta-title", "lang": null, "content": "සංයුත්ත නිකාය"}, {"seq": 1, "tag": "h1", "class": "sutta-title", "lang": null, "content": "මහා වග්ගෝ"}, {"seq": 2, "tag": "h2", "class": "sutta-title", "lang": null, "content": "18. පුනඕඝවග්ගෝ"}, {"seq": 3, "tag": "h3", "class": "sutta-title", "lang": null, "content": "18. පුන ඕඝ වර්ගය"}, {"seq": 4, "tag": "h2", "class": "sutta-title", "lang": null, "content": "2.18.1.-120 ඕඝාදී සූත්‍රයෝ"}, {"seq": 5, "tag": "h3", "class": "sutta-title", "lang": null, "content": "සැඩපහර ගැන වදාළ දෙසුම ආදී දෙසුම්"}, {"seq": 6, "tag": "p", "class": "pali-text", "lang": "pali", "content": "(රාගවිනයාදිවසේන විත්ථාරේතබ්බානි)"}, {"seq": 7, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(රාග විනයාදී වශයෙන් විස්තර කළ යුත්තාහු ය.)"}, {"seq": 8, "tag": "p", "class": "sutta-title", "lang": null, "content": "පුනඕඝවග්ගෝ අට්ඨාරසමෝ."}, {"seq": 9, "tag": "p", "class": "sutta-title", "lang": null, "content": "දහඅට වෙනි පුන ඕඝ වර්ගය අවසන් විය."}, {"seq": 10, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තත්‍රැද්දානං:"}, {"seq": 11, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "එහි පිළිවෙල උද්දානයයි :"}, {"seq": 12, "tag": "p", "class": "gatha pali-text", "lang": "pali", "content": "ඕඝෝ යෝගෝ උපාදානං ගන්ථෝ අනුසයේන ච,\nකාමගුණා නීවරණා ඛන්ධා ඕරුද්ධම්භාගියාති"}, {"seq": 13, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "ඕඝ, යෝග, උපාදාන, ගන්ථ, අනුසය, කාමගුණ, නීවරණ, ඛන්ධ, ඕරම්භාගිය, උද්ධම්භාගිය වශයෙන් දොළොස බැගින් දසයකි. මෙහි මුළු සූත්‍ර ගණන එකසිය විස්සකි."}, {"seq": 14, "tag": "p", "class": "sutta-title", "lang": null, "content": "බොජ්ඣංගසංයුත්තං සමත්තං."}, {"seq": 15, "tag": "p", "class": "sutta-title", "lang": null, "content": "බොජ්ඣංග සංයුත්තය අවසන් විය."}, {"seq": 16, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තත්‍ර වග්ගුද්දානං:"}, {"seq": 17, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "එහි වර්ග නාමාවලිය :"}, {"seq": 18, "tag": "p", "class": "gatha pali-text", "lang": "pali", "content": "පබ්බතෝ ගිලානුදායී නීවරණෝ චක්කවත්ති\nබොජ්ඣංගෝ වානාපානෝ ච නිරෝධගංගාපෙය්‍යාලෝ\nඅප්පමාදෝ බලකරණීයෝ ඒසනෝඝා පුනාදිහි\nගංගාපෙය්‍යාල ආදීහි පඤ්චහට්ඨාරසේව තේති"}, {"seq": 19, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "පබ්බත, ගිලාන, උදායී, නීවරණ, චක්කවත්තී, බොජ්ඣංග, ආනාපාන, නිරෝධ, ගංගා පෙය්‍යාල, අප්පමාද, බලකරණීය, ඒසනා, ඕඝ යන මේ වර්ගයන් යළිත් පුන යන මුල්කොට ඇති පුන ගංගා පෙය්‍යාලය, පුන අප්පමාද, පුන බලකරණීය, පුන ඒසනා, පුන ඕඝ වශයෙන් පස ත් සමඟ බොජ්ඣංග සංයුත්තයේ වර්ග දහඅටකි."}], "bjt": {"pali": [{"seq": 0, "tag": "centered", "content": "(පඨමො ගන්ථො)"}, {"seq": 1, "tag": "heading", "content": "ඛුද්දකපාඨපාළි"}, {"seq": 2, "tag": "centered", "content": "නමො තස්ස භගවතො අරහතො සම්මාසම්බුද්ධස්ස."}, {"seq": 3, "tag": "heading", "content": "1. සරණගමනං"}, {"seq": 4, "tag": "paragraph", "content": "බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 5, "tag": "paragraph", "content": "ධම්මං සරණං ගච්ඡාමි."}, {"seq": 6, "tag": "paragraph", "content": "සඞ්ඝං සරණං ගච්ඡාමි."}, {"seq": 7, "tag": "paragraph", "content": "දුතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 8, "tag": "paragraph", "content": "දුතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 9, "tag": "paragraph", "content": "දුතියම්පි සඞ්ඝං සරණං ගච්ඡාමි."}], "sinhala": [{"seq": 0, "tag": "centered", "content": "(ප්රථම ග්රන්ථය)"}, {"seq": 1, "tag": "heading", "content": "ඛුද්දකපාඨ පෙළ"}, {"seq": 2, "tag": "centered", "content": "ඒ භාග්යවත් අර්හත් සම්මාසම්බුදුරජාණන් වහන්සේට නමස්කාර වේවා."}, {"seq": 3, "tag": "heading", "content": "1. ශරණගමනය"}, {"seq": 4, "tag": "paragraph", "content": "බුදුරජුන් සරණයෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 5, "tag": "paragraph", "content": "දහම් සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 6, "tag": "paragraph", "content": "සඟ සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 7, "tag": "paragraph", "content": "දෙවනු ද බුදුරජුන් සරණ යෙමි."}, {"seq": 8, "tag": "paragraph", "content": "දෙවනු ද දහම් සරණ යෙමි."}, {"seq": 9, "tag": "paragraph", "content": "දෙවනු ද සඟ සරණ යෙමි."}]}}