{"source_id": 11713, "link": "kn1_1", "label": " සරණගමනං", "book": "kn1", "url": "https://tripitaka.online/sutta/11713", "prev": {"source_id": 11710, "link": "kn1_4-4", "label": " චතුක්ක නිපාතෝ", "book": "kn1"}, "next": {"source_id": 11715, "link": "kn1_2", "label": " දසසික්ඛාපදං", "book": "kn1"}, "blocks": [{"seq": 0, "tag": "h1", "class": "sutta-title", "lang": null, "content": "ඛුද්දක නිකාය"}, {"seq": 1, "tag": "h1", "class": "sutta-title", "lang": null, "content": "ඛුද්දකපාඨ පාළි"}, {"seq": 2, "tag": "h2", "class": "sutta-title", "lang": null, "content": "1. සරණගමනං"}, {"seq": 3, "tag": "h3", "class": "sutta-title", "lang": null, "content": "1. තිසරණ සරණ යෑම"}, {"seq": 4, "tag": "p", "class": "pali-text", "lang": "pali", "content": "බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 5, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) බුදුරජාණන් වහන්සේව සරණ යමි."}, {"seq": 6, "tag": "p", "class": "pali-text", "lang": "pali", "content": "ධම්මං සරණං ගච්ඡාමි."}, {"seq": 7, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) ශ්‍රී සද්ධර්මය සරණ යමි."}, {"seq": 8, "tag": "p", "class": "pali-text", "lang": "pali", "content": "සංඝං සරණං ගච්ඡාමි."}, {"seq": 9, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) මාර්ගඵල ලාභී ආර්ය වූ ශ්‍රාවක සංඝරත්නය සරණ යමි."}, {"seq": 10, "tag": "p", "class": "pali-text", "lang": "pali", "content": "දුතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 11, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) දෙවනුවත් බුදුරජාණන් වහන්සේව සරණ යමි."}, {"seq": 12, "tag": "p", "class": "pali-text", "lang": "pali", "content": "දුතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 13, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) දෙවනුවත් ශ්‍රී සද්ධර්මය සරණ යමි."}, {"seq": 14, "tag": "p", "class": "pali-text", "lang": "pali", "content": "දුතියම්පි සංඝං සරණං ගච්ඡාමි."}, {"seq": 15, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) දෙවනුවත් මාර්ගඵල ලාභී ආර්ය වූ ශ්‍රාවක සංඝරත්නය සරණ යමි."}, {"seq": 16, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 17, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) තෙවනුවත් බුදුරජාණන් වහන්සේව සරණ යමි."}, {"seq": 18, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 19, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) තෙවනුවත් ශ්‍රී සද්ධර්මය සරණ යමි."}, {"seq": 20, "tag": "p", "class": "pali-text", "lang": "pali", "content": "තතියම්පි සංඝං සරණං ගච්ඡාමි."}, {"seq": 21, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "(මම) තෙවනුවත් මාර්ගඵල ලාභී ආර්ය වූ ශ්‍රාවක සංඝරත්නය සරණ යමි."}, {"seq": 22, "tag": "p", "class": "sutta-title pali-text", "lang": "pali", "content": "සරණගමනං."}, {"seq": 23, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": ""}, {"seq": 24, "tag": "p", "class": "sutta-title sinhala-text", "lang": "sinhala", "content": "මේ වනාහී තිසරණ සරණ යෑමයි."}, {"seq": 25, "tag": "p", "class": "sutta-title sinhala-text", "lang": "sinhala", "content": "සාදු! සාදු!! සාදු!!!"}], "bjt": {"pali": [{"seq": 0, "tag": "paragraph", "content": "බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 1, "tag": "paragraph", "content": "ධම්මං සරණං ගච්ඡාමි."}, {"seq": 2, "tag": "paragraph", "content": "සඞ්ඝං සරණං ගච්ඡාමි."}, {"seq": 3, "tag": "paragraph", "content": "දුතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 4, "tag": "paragraph", "content": "දුතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 5, "tag": "paragraph", "content": "දුතියම්පි සඞ්ඝං සරණං ගච්ඡාමි."}, {"seq": 6, "tag": "paragraph", "content": "තතියම්පි බුද්ධං සරණං ගච්ඡාමි."}, {"seq": 7, "tag": "paragraph", "content": "තතියම්පි ධම්මං සරණං ගච්ඡාමි."}, {"seq": 8, "tag": "paragraph", "content": "තතියම්පි සඞ්ඝං සරණං ගච්ඡාමි."}, {"seq": 9, "tag": "centered", "content": "සරණගමනං."}, {"seq": 10, "tag": "heading", "content": "2. දසසික්ඛාපදං"}, {"seq": 11, "tag": "paragraph", "content": "පාණාතිපාතා වෙරමණීසික්ඛාපදං සමාදියාමි."}, {"seq": 12, "tag": "paragraph", "content": "අදින්නාදානා වෙරමණීසික්ඛාපදං සමාදියාමි."}], "sinhala": [{"seq": 0, "tag": "paragraph", "content": "බුදුරජුන් සරණයෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 1, "tag": "paragraph", "content": "දහම් සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 2, "tag": "paragraph", "content": "සඟ සරණ යෙමි (පිහිට යැ යි දැන ගණිමි.)"}, {"seq": 3, "tag": "paragraph", "content": "දෙවනු ද බුදුරජුන් සරණ යෙමි."}, {"seq": 4, "tag": "paragraph", "content": "දෙවනු ද දහම් සරණ යෙමි."}, {"seq": 5, "tag": "paragraph", "content": "දෙවනු ද සඟ සරණ යෙමි."}, {"seq": 6, "tag": "paragraph", "content": "තෙවනු ද බුදුරජුන් සරණ යෙමි."}, {"seq": 7, "tag": "paragraph", "content": "තෙවනු ද දහම් සරණ යෙමි."}, {"seq": 8, "tag": "paragraph", "content": "තෙවනු ද සඟ සරණ යෙමි."}, {"seq": 9, "tag": "centered", "content": "ශරණගමනය යි."}, {"seq": 10, "tag": "heading", "content": "2. දසසිකපද"}, {"seq": 11, "tag": "paragraph", "content": "පණිවායෙන් වැළැක්ම වූ සිකපදය මනා කොට ගණිමි."}]}}