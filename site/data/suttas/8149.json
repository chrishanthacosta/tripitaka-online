{"source_id": 8149, "link": "an1_3-3-5-9", "label": "", "book": "an1", "url": "https://tripitaka.online/sutta/8149", "prev": {"source_id": 8148, "link": "an1_3-3-5-8", "label": "", "book": "an1"}, "next": {"source_id": 8150, "link": "an1_3-3-5-10", "label": "", "book": "an1"}, "blocks": [{"seq": 0, "tag": "h1", "class": "sutta-title", "lang": null, "content": "අංගුත්තර නිකාය"}, {"seq": 1, "tag": "h1", "class": "sutta-title", "lang": null, "content": "තික නිපාතෝ"}, {"seq": 2, "tag": "h2", "class": "sutta-title", "lang": null, "content": "3.3.5.9."}, {"seq": 3, "tag": "p", "class": "pali-text", "lang": "pali", "content": "52. තිස්සෝ ඉමා භික්ඛවේ, වන්දනා."}, {"seq": 4, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": ""}, {"seq": 5, "tag": "p", "class": "pali-text", "lang": "pali", "content": "කතමා තිස්සෝ?"}, {"seq": 6, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "52. පින්වත් මහණෙනි, මේ වැඳීම් තුනක් තියෙනවා. ඒ තුන මොනවාද?"}, {"seq": 7, "tag": "p", "class": "pali-text", "lang": "pali", "content": "කායේන වාචාය මනසා."}, {"seq": 8, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": ""}, {"seq": 9, "tag": "p", "class": "pali-text", "lang": "pali", "content": "ඉමා ඛෝ භික්ඛවේ, තිස්සෝ වන්දනාති."}, {"seq": 10, "tag": "p", "class": "sinhala-text", "lang": "sinhala", "content": "කයෙන්, වචනයෙන් හා සිතින්ය. පින්වත් මහණෙනි, මේ තමයි වැඳීම් තුන."}, {"seq": 11, "tag": "p", "class": "sutta-title sinhala-text", "lang": "sinhala", "content": "සාදු! සාදු!! සාදු!!!"}], "bjt": null}